---
const { rating, reviews } = Astro.props;

interface Props {
  rating?: string;
  reviews?: string;
}
---

<div class="mt-6 lg:mt-10">
  <div class="py-5">
    <div class="text-center sm:flex sm:items-center sm:text-start">
      <!-- Accréditation Text -->
      <div class="flex flex-col items-center sm:items-start text-start">
        <p class="text-lg text-neutral-800 dark:text-neutral-200">
          <Fragment set:html={rating} />
        </p>
        <div class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">
          <p>
            <Fragment set:html={reviews} />
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
