---
import { Image } from "astro:assets";
import logoESUP from "@images/logo_esup_sante.png";
const { class: className, ...rest } = Astro.props;
---
<div class:list={["flex items-center gap-2", className]} {...rest}>
  <Image
    src={logoESUP}
    alt="Logo ESUP SANTÉ"
    class="h-12 w-auto shrink-0"
    draggable={"false"}
    loading={"eager"}
  />
</div>
