---
// Import SecondaryCTA component for use in this module
import SecondaryCTA from "@components/ui/buttons/SecondaryCTA.astro";
import Icon from "@components/ui/icons/Icon.astro";

// Define props from Astro
const { pricing } = Astro.props;

// Define TypeScript type for products.
type Product = {
  name: string;
  description: string;
  price: string;
  cents: string;
  billingFrequency: string;
  isAccredited: boolean;
  features: Array<string>;
  purchaseBtnTitle: string;
  purchaseLink: string;
};

interface PricingSectionProps {
  title: string;
  subTitle: string;
  badge: string;
  thirdOption: string;
  btnText: string;
  pricing: {
    title: string;
    subTitle: string;
    badge: string;
    thirdOption: string;
    btnText: string;
    products: Array<Product>;
  };
}
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <!-- Section heading and sub-heading -->
  <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
    <h2
      class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
    >
      {pricing.title}
    </h2>
    <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
      {pricing.subTitle}
    </p>
  </div>
  <!-- Contains products blocks dynamically rendered -->
  <div class="grid grid-cols-1 gap-6 sm:gap-8 xl:grid-cols-3 items-stretch">
    {
      pricing.products.map((product: Product) => (
        <div
          class={
            product.isAccredited
              ? "w-full rounded-xl bg-linear-to-tr from-[#FF512F] to-[#F09819] p-6 shadow-xl sm:p-8 flex flex-col"
              : "w-full rounded-xl bg-gray-800 p-6 sm:p-8 flex flex-col"
          }
        >
          <div class="mb-4 flex flex-col items-start justify-between gap-4 lg:flex-row">
            <div>
              <h3 class="text-2xl font-bold text-neutral-100 sm:text-3xl">
                {product.name}
              </h3>
              <p class={product.isAccredited ? "text-orange-200" : "text-indigo-300"}>
                {product.description}
              </p>
            </div>

            {product.isAccredited ? (
              <span class="order-first inline-block rounded-full bg-orange-200/60 bg-opacity-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-center text-orange-600 lg:order-none">
                {pricing.badge}
              </span>
            ) : null}
          </div>

          <div class="mb-4">
            <span class={product.isAccredited ? "text-5xl font-bold text-neutral-100 lg:text-5xl 2xl:text-6xl" : "text-4xl font-bold text-neutral-200 lg:text-4xl 2xl:text-5xl"}>
              {product.price}
            </span>
            <span class={product.isAccredited ? "text-lg font-bold text-orange-100" : "text-lg font-bold text-neutral-300"}>
              {product.cents}
            </span>
            <span class={product.isAccredited ? "ms-3 text-orange-200" : "ms-3 text-sm text-indigo-200"}>
              {product.billingFrequency}
            </span>
          </div>

          <ul class={product.isAccredited ? "mb-6 space-y-2 text-orange-100 grow" : "mb-6 space-y-2 text-neutral-300 grow"}>
            {product.features.map((feature: string) => (
              <li class="flex text-sm sm:text-base items-center gap-1.5">
                <Icon name="checkCircle" />
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href={product.purchaseLink}
            class={
              product.isAccredited
                ? "block mt-auto rounded-lg bg-orange-200/40 bg-opacity-50 px-8 py-3 text-center text-sm font-bold text-neutral-100 outline-hidden ring-green-400 transition duration-300 hover:bg-green-400 focus-visible:ring-3 active:bg-green-600 md:text-base"
                : "block mt-auto rounded-lg bg-gray-500 px-8 py-3 text-center text-sm font-bold text-gray-100 outline-hidden ring-indigo-300 transition duration-100 hover:bg-gray-600 focus-visible:ring-3 active:text-gray-300 md:text-base"
            }
          >
            {product.purchaseBtnTitle}
          </a>
        </div>
      ))
    }
  </div>
  <!-- Call to action for Enterprise Solutions -->
  <div class="mt-8 flex items-center justify-center gap-x-3 md:mt-12">
    <p class="text-sm text-neutral-600 dark:text-neutral-400">
      {pricing.thirdOption}
    </p>

    <SecondaryCTA title={pricing.btnText} url="/contact" />
  </div>
</section>
