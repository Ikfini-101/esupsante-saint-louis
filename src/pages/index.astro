---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import FeaturesNavs from "@components/sections/features/FeaturesNavs.astro";
import PricingSection from "@components/sections/pricing/PricingSection.astro";
import FAQ from "@components/sections/misc/FAQ.astro";
import AnnouncementBanner from "@components/ui/banners/AnnouncementBanner.astro";
import heroImage from "@images/groupe-blouses-roses.jpg";
import faqs from "@data/faqs.json";
import features from "@data/features.json";
import pricing from "@data/pricing.json";
import featureImage from "@images/facade-campus.jpg";
import etudiantStethoscope from "@images/etudiant-stethoscope.jpg";
import etudiantsStage from "@images/etudiants-stage.jpg";
import etudiantesClasse from "@images/etudiantes-classe.jpg";
import carouselPast1 from "@images/carousel-past-1.jpg";
import carouselPast2 from "@images/carousel-past-2.jpg";
import carouselPresent1 from "@images/carousel-present-1.jpg";
import carouselPresent2 from "@images/carousel-present-2.jpg";
import carouselPresent3 from "@images/carousel-present-3.jpg";
import carouselPresent4 from "@images/carousel-present-4.jpg";
---

<MainLayout>
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle="Candidater maintenant →"
    url="/contact"
  />

  <HeroSection
    title=`Devenez un Professionnel de la <span
        class="text-yellow-500 dark:text-yellow-400">Santé</span>`
    subTitle="ESUP SANTÉ forme les leaders de demain dans le secteur de la santé. Licences, diplômes d'État et formations continues — à Saint-Louis, Sénégal."
    primaryBtn="Découvrir nos formations"
    primaryBtnURL="/formations"
    secondaryBtn="Nous contacter"
    secondaryBtnURL="/contact"
    withReview={true}
    avatars={[]}
    rating=`<span class="font-bold">3</span> filières accréditées`
    starCount={5}
    reviews=`Plus de <span class="font-bold">10 ans</span> d'expérience`
    src={heroImage}
    alt="Étudiantes en blouses roses ESUP SANTÉ — promotion à Saint-Louis"
  />

  <FeaturesGeneral
    title="Une école au service de l'excellence en santé"
    subTitle="Fondée à Saint-Louis, ESUP SANTÉ est une école supérieure de formation professionnelle en santé. Nous accompagnons nos étudiants vers des carrières d'impact à travers des programmes rigoureux, un corps professoral qualifié et un environnement propice à l'apprentissage (Plus de 10 ans d'évolution)."
    carouselImages={[
      { src: carouselPresent3, alt: "Façade actuelle du campus ESUP SANTÉ" },
      { src: carouselPast1, alt: "Les débuts de l'école - Le passé" },
      { src: carouselPresent1, alt: "Promotion actuelle - Blouses roses" },
      { src: carouselPast2, alt: "Ancienne promotion ESUP SANTÉ" },
      { src: carouselPresent2, alt: "Formation pratique et clinique" },
      { src: carouselPresent4, alt: "Groupe officiel ESUP SANTÉ" },
    ]}
    features={features}
  />

  <FeaturesNavs
    title=`Nos missions au cœur de votre <span class="text-yellow-500 dark:text-yellow-400">réussite</span>`
    tabs={[
      {
        heading: "Formation Initiale",
        content:
          "Nous formons des Techniciens Supérieurs de Santé, des Licenciés en Sciences Infirmières et Obstétricales, des Assistants Infirmiers Diplômés d'État, des Infirmiers et Sages-Femmes d'État, ainsi que des Délégués Médicaux. Chaque filière est pensée pour répondre aux besoins du système de santé sénégalais.",
        svg: "tools",
        src: etudiantStethoscope,
        alt: "Étudiant ESUP SANTÉ en blouse blanche avec stéthoscope",
        first: true,
      },
      {
        heading: "Formation Continue",
        content:
          "ESUP SANTÉ propose des programmes de formation continue destinés aux professionnels de santé en activité. Perfectionnement, mise à niveau et formations à la carte permettent aux praticiens de rester au plus haut niveau de compétence.",
        svg: "dashboard",
        src: etudiantsStage,
        alt: "Étudiants en blouses blanches lors d'un stage hospitalier",
        second: true,
      },
      {
        heading: "Études & Conseil",
        content:
          "Notre pôle recherche mène des études dans les domaines de la santé publique et des sciences biologiques. Nous offrons également des services de conseil aux institutions sanitaires pour améliorer la qualité des soins.",
        svg: "house",
        src: etudiantesClasse,
        alt: "Étudiantes et enseignante en salle de cours — chirurgie",
      },
    ]}
  />

  <PricingSection pricing={pricing} />

  <FAQ title="Questions<br />fréquentes" faqs={faqs} />

  <HeroSectionAlt
    title="Construisez votre avenir dans la santé"
    subTitle="Rejoignez ESUP SANTÉ et intégrez une communauté de professionnels engagés pour l'excellence en santé. Inscriptions ouvertes 2025–2026."
    url="/contact"
  />
</MainLayout>
