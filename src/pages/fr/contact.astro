---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import ContactSection from "@components/sections/fr/ContactSection_fr.astro";
import { SITE } from "@data/constants";

const pageTitle: string = `Nous Contacter | ${SITE.title}`;
const metaDescription =
  "Une question ? Un projet de formation ? Contactez ESUP SANTÉ à Saint-Louis pour en savoir plus sur nos filières et modalités d'inscription.";
const ogTitle = `Nous Contacter | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  lang="fr"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://esupsante.com/fr/contact",
    url: "https://esupsante.com/fr/contact",
    name: `Nous Contacter | ${SITE.title}`,
    description:
      "Contactez ESUP SANTÉ à Saint-Louis pour toute information sur nos formations professionnelles en santé.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://esupsante.com/fr/",
      name: SITE.title,
      description:
        SITE.description,
    },
    inLanguage: "fr",
  }}
>
  <ContactSection />
</MainLayout>
