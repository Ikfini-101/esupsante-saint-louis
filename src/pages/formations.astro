---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import etudiantStethoscope from "@images/etudiant-stethoscope.jpg";
import etudiantsStage from "@images/etudiants-stage.jpg";
import etudiantesClasse from "@images/etudiantes-classe.jpg";
import groupeBlousesRoses from "@images/groupe-blouses-roses.jpg";
import facadeCampus from "@images/facade-campus.jpg";
import groupeFacade from "@images/groupe-facade.jpg";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Licence Sage-femme d'État",
    subTitle:
      "La Licence Sage-femme d'État forme des professionnels capables d'accompagner les femmes tout au long de la grossesse, lors de l'accouchement et en suites de couches. Reconnue par l'ANAQ-SUP, cette formation d'excellence garantit une pratique sécurisée.\n\n📋 Niveau requis : BAC | Durée : 3 ans\n💰 Inscription : 100 000 FCFA | Mensualité : 50 000 FCFA\n🩺 Frais de stage : 20 000 FCFA | Kit de stage : 20 000 FCFA",
    single: false,
    imgOne: etudiantStethoscope,
    imgOneAlt: "Étudiant en blouse blanche avec stéthoscope",
    imgTwo: etudiantsStage,
    imgTwoAlt: "Étudiants lors d'un stage en milieu hospitalier",
  },
  {
    isRightSection: false,
    title: "Licence Infirmier d'État",
    subTitle:
      "La Licence Infirmier d'État prépare de véritables piliers du système de santé, capables d'assurer les soins préventifs, curatifs et palliatifs. Ce parcours est accrédité par l'ANAQ-SUP.\n\n📋 Niveau requis : BAC | Durée : 3 ans\n💰 Inscription : 100 000 FCFA | Mensualité : 50 000 FCFA\n🩺 Frais de stage : 20 000 FCFA | Kit de stage : 20 000 FCFA",
    img: groupeBlousesRoses,
    imgAlt: "Étudiantes ESUP SANTÉ en blouses roses sur le campus",
    btnExists: true,
    btnTitle: "Déposer mon dossier",
    btnURL: "/contact",
  },
  {
    isRightSection: true,
    title: "Assistant infirmier d'État",
    subTitle:
      "Ce programme forme des assistants infirmiers compétents, aptes à seconder efficacement les équipes médicales dans les actes de soins au quotidien.\n\n📋 Niveau requis : BFEM | Durée : 2 ans\n💰 Inscription : 80 000 FCFA | Mensualité : 40 000 FCFA\n🩺 Frais de stage : 20 000 FCFA | Kit de stage : 20 000 FCFA",
    single: false,
    imgOne: etudiantesClasse,
    imgOneAlt: "Étudiantes en salle de classe — cours de chirurgie",
    imgTwo: facadeCampus,
    imgTwoAlt: "Façade du campus ESUP SANTÉ",
  },
  {
    isRightSection: false,
    title: "Conditions Générales d'Admission",
    subTitle:
      "Le dossier de candidature doit comprendre :\n\n✓ Demande manuscrite adressée au Directeur\n✓ Photocopie du ou des diplômes légalisés\n✓ Photocopie légalisée du certificat de nationalité\n✓ 3 photos d'identité\n✓ Extrait de Naissance\n✓ Certificat de visite et contre-visite\n✓ Photocopie légalisée de la carte nationale d’identité\n✓ Fiche de renseignement à remplir",
    img: groupeFacade,
    imgAlt: "Groupe d'étudiants devant le campus ESUP SANTÉ",
    btnExists: true,
    btnTitle: "Nous contacter",
    btnURL: "/contact",
  },
];

const pageTitle: string = `Nos Formations | ${SITE.title}`;
const metaDescription =
  "Découvrez nos 3 filières : Licence Sage-femme d'État, Licence Infirmier d'État, Assistant infirmier d'État. Inscriptions ouvertes à Saint-Louis.";
const ogTitle = "Nos Formations | ESUP SANTÉ";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/formations`,
    url: `${SITE.url}/formations`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: "fr-FR",
  }}
>
  <MainSection
    title="Nos Formations"
    subTitle="Trois filières d'excellence pour construire votre carrière dans le secteur de la santé. Chaque programme est conçu pour répondre aux besoins du système de santé sénégalais."
    btnExists={true}
    btnTitle="Candidater maintenant"
    btnURL="/contact"
  />
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  <FeaturesStats
    title="ESUP SANTÉ en chiffres"
    subTitle="Notre engagement envers la qualité et l'excellence se reflète dans chaque promotion. ESUP SANTÉ est dédiée à former les meilleurs professionnels de santé du Sénégal."
    mainStatTitle="2"
    mainStatSubTitle="filières professionnelles accréditées par l'ANAQ-SUP"
    stats={[
      {
        stat: "15+",
        description: "années d'expérience en formation santé",
      },
      {
        stat: "BAC / BFEM",
        description: "niveau minimum requis pour les filières",
      },
      {
        stat: "40.000",
        description: "FCFA de frais liés au stage (frais + kit)",
      },
    ]}
  />
</MainLayout>
