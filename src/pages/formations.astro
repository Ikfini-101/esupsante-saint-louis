---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import etudiantStethoscope from "@images/etudiant-stethoscope.jpg";
import etudiantsStage from "@images/etudiants-stage.jpg";
import etudiantesClasse from "@images/etudiantes-classe.jpg";
import groupeBlousesRoses from "@images/groupe-blouses-roses.jpg";
import facadeCampus from "@images/facade-campus.jpg";
import groupeFacade from "@images/groupe-facade.jpg";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Licence en Sciences Infirmières & Obstétricales",
    subTitle:
      "La Licence en Sciences Infirmières et Obstétricales prépare les étudiants à devenir des professionnels polyvalents et qualifiés. Le programme couvre les soins infirmiers généraux, la santé maternelle et infantile, la pharmacologie, l'anatomie, et les techniques de soins spécialisés. Les diplômés sont aptes à exercer dans les hôpitaux, cliniques et centres de santé.\n\n📋 Niveau requis : BAC | Durée : 3 ans\n💰 Inscription : 100 000 FCFA | Mensualité : 50 000 FCFA | Stage : 20 000 FCFA",
    single: false,
    imgOne: etudiantStethoscope,
    imgOneAlt: "Étudiant en blouse blanche avec stéthoscope",
    imgTwo: etudiantsStage,
    imgTwoAlt: "Étudiants lors d'un stage en milieu hospitalier",
  },
  {
    isRightSection: false,
    title: "Assistant(e) Infirmier(ère)",
    subTitle:
      "Ce programme forme des assistants infirmiers capables d'assister les équipes soignantes dans les actes de soins courants. La formation allie théorie et pratique clinique pour garantir une insertion professionnelle rapide dans les structures de santé publiques et privées.\n\n📋 Niveau requis : BAC | Durée : 2 ans\n💰 Inscription : 80 000 FCFA | Mensualité : 40 000 FCFA | Stage : 20 000 FCFA",
    img: groupeBlousesRoses,
    imgAlt: "Étudiantes ESUP SANTÉ en blouses roses sur le campus",
    btnExists: true,
    btnTitle: "Déposer mon dossier",
    btnURL: "/contact",
  },
  {
    isRightSection: true,
    title: "Technicien Supérieur de Santé",
    subTitle:
      "Cette formation s'adresse aux titulaires d'un Diplôme d'État de Sage-Femme ou d'Infirmier. Les professionnels justifiant de 4 ans d'expérience ou titulaires d'un diplôme admis en équivalence peuvent également postuler. Le programme vise à approfondir les compétences techniques et cliniques pour accéder à des postes de responsabilité dans les structures de santé.\n\n📋 Niveau requis : BAC / BFEM + expérience",
    single: false,
    imgOne: etudiantesClasse,
    imgOneAlt: "Étudiantes en salle de classe — cours de chirurgie",
    imgTwo: facadeCampus,
    imgTwoAlt: "Façade du campus ESUP SANTÉ",
  },
  {
    isRightSection: false,
    title: "Conditions Générales d'Admission",
    subTitle:
      "Le dossier de candidature doit comprendre :\n\n✓ Demande manuscrite\n✓ Attestation ou photocopie légalisée du diplôme exigé\n✓ Certificat de visite et de contre-visite médical\n✓ Extrait de casier judiciaire\n✓ Extrait d'acte de naissance\n✓ 03 photos d'identité\n✓ Certificat de Nationalité Sénégalaise\n✓ Carte nationale d'identité",
    img: groupeFacade,
    imgAlt: "Groupe d'étudiants devant le campus ESUP SANTÉ",
    btnExists: true,
    btnTitle: "Nous contacter",
    btnURL: "/contact",
  },
];

const pageTitle: string = `Nos Formations | ${SITE.title}`;
const metaDescription =
  "Découvrez nos 3 filières : Licence Sciences Infirmières, Assistant Infirmier, Technicien Supérieur de Santé. Inscriptions ouvertes à Saint-Louis.";
const ogTitle = "Nos Formations | ESUP SANTÉ";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/formations`,
    url: `${SITE.url}/formations`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: "fr-FR",
  }}
>
  <MainSection
    title="Nos Formations"
    subTitle="Trois filières d'excellence pour construire votre carrière dans le secteur de la santé. Chaque programme est conçu pour répondre aux besoins du système de santé sénégalais."
    btnExists={true}
    btnTitle="Candidater maintenant"
    btnURL="/contact"
  />
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  <FeaturesStats
    title="ESUP SANTÉ en chiffres"
    subTitle="Notre engagement envers la qualité et l'excellence se reflète dans chaque promotion. ESUP SANTÉ est dédiée à former les meilleurs professionnels de santé du Sénégal."
    mainStatTitle="3"
    mainStatSubTitle="filières professionnelles accréditées par l'État"
    stats={[
      {
        stat: "15+",
        description: "années d'expérience en formation santé",
      },
      {
        stat: "BAC",
        description: "niveau minimum requis pour les filières principales",
      },
      {
        stat: "20K",
        description: "FCFA de frais de stage annuels",
      },
    ]}
  />
</MainLayout>
